<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zemo_bringup</name>
  <version>0.0.0</version>
  <description>
    This package groups all package launch files into one high level launch.
    It also includes launch configurations for rviz and simulation.
  </description>
  <maintainer email="vladimirandrisko@gmail.com">Vladimir</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>zemo_hardware</depend>
  <depend>zemo_msgs</depend>
  <depend>zemo_navigation</depend>  

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
