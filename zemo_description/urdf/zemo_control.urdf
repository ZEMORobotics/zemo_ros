<?xml version="1.0"?>
<robot name="zemo" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="zemo_control">

    <xacro:property name="servo_mode_position" value="0">
    <xacro:property name="servo_mode_velocity" value="1">

    <ros2_control name="CanInterface" type="system">
        <hardware>
            <plugin>zemo_hardware::CanInterface</plugin>

            <param name="can.interface">can0</param>

            <param name="diff_drive.kp">1.0</param>
            <param name="diff_drive.ki">0.0</param>
            <param name="diff_drive.kd">0.0</param>

            <param name="diff_drive.kp_angular">1.0</param>
            <param name="diff_drive.ki_angular">0.0</param>
            <param name="diff_drive.kd_angular">0.0</param>

            <!-- 4 * 2048 -->
            <param name="diff_drive.enc_tick_per_rev">8192</param>     

        </hardware>

        <!-- Diff Drive -->
        
        <joint name="wheel_left_joint">
            <state_interface name="position" data_type="float32">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" data_type="float32">
                <param name="initial_value">0.0</param>
            </state_interface>
            <command_interface name="velocity" data_type="float32">
                <param name="initial_value">0.0</param>
            </command_interface>
        </joint>

        <joint name="wheel_right_joint">
            <state_interface name="position" data_type="float32">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" data_type="float32">
                <param name="initial_value">0.0</param>
            </state_interface>
            <command_interface name="velocity" data_type="float32">
                <param name="initial_value">0.0</param>
            </command_interface>
        </joint>
    </ros2_control>

    <ros2_control name="ServoInterface_uart0" type="system">
        <hardware>
            <plugin>zemo_hardware::ServoInterface</plugin>

            <param name="port">/dev/ttyAMA0</param>
            <param name="baudrate">115200</param>
            <param name="protocol_type">sms_sts</param> <!-- Waveshare ST3215 protocol -->
            <param name="tx_en_pin">23</param>
            <param name="rx_en_pin">24</param>
        </hardware>

        <joint name="m1">
            <param name="id">1</param>
            <param name="mode">${servo_mode_position}</param>
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="acceleration"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>

    <!-- <ros2_control name="ServoInterface_uart1" type="system">
        <hardware>
            <plugin>zemo_hardware::ServoInterface</plugin>
        </hardware>


    </ros2_control> -->

    </xacro:macro>
</robot>